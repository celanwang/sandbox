          "type": "boolean"
        },
        "orderType": {
          "description": "麦乐送使用 2",
          "enum": [
            2
          ],
          "type": "integer"
        },
        "remark": {
          "description": "订单备注（选填，最多50字），如\"无接触配送\"，仅orderType=2场景下需要引导用户填写",
          "type": "string"
        },
        "reservationDate": {
          "description": "预约场景必传，非预约场景不传。格式:yyyy-MM-dd HH:mm",
