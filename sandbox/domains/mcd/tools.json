[
  {
    "name": "calculate-price",
    "description": "为指定门店的麦乐送购物车计算商品价、配送费、打包费及总价。返回的金额以分计。",
    "inputSchema": {
      "properties": {
        "beCode": {
          "description": "业务编码，与storeCode 配对使用，从query-nearby-stores或delivery-query-stores返回结果中获取。得来速(beType=5)/外送(orderType=2)/团餐场景必传，到店自取(beType=1)场景不传",
          "type": "string"
        },
        "beType": {
          "description": "麦乐送使用 2",
          "enum": [
            2
          ],
          "type": "integer"
        },
        "items": {
          "description": "商品列表。套餐未传 roundList 时使用默认搭配。",
          "items": {
            "description": "",
            "properties": {
              "couponCode": {
                "description": "优惠券code",
                "type": "string"
              },
              "couponId": {
                "description": "优惠券Id",
                "type": "string"
              },
              "productCode": {
                "description": "商品code",
                "type": "string"
              },
              "quantity": {
                "description": "数量，必填，不能为空，且大于等于1",
                "type": "integer",
                "minimum": 1
              },
              "roundList": {
                "description": "套餐子项",
                "items": {
                  "properties": {
                    "comboItemList": {
                      "description": "套餐套餐round下商品",
                      "items": {
                        "properties": {
                          "code": {
                            "description": "商品编码",
                            "type": "string"
                          },
                          "quantity": {
                            "description": "商品数量",
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "type": "object",
                        "required": [
                          "code",
                          "quantity"
                        ]
                      },
                      "type": "array"
                    },
                    "round": {
                      "description": "套餐round",
                      "type": "string"
                    }
                  },
                  "type": "object",
                  "required": [
                    "round",
                    "comboItemList"
                  ]
                },
                "type": "array"
              }
            },
            "type": "object",
            "required": [
              "productCode",
              "quantity"
            ]
          },
          "type": "array",
          "minItems": 1
        },
        "needTableware": {
          "description": "是否需要餐具，true需要，false不需要",
          "type": "boolean"
        },
        "orderType": {
          "description": "麦乐送使用 2",
          "enum": [
            2
          ],
          "type": "integer"
        },
        "storeCode": {
          "description": "门店编码（storeCode）, 不能为空",
          "type": "string"
        }
      },
      "required": [
        "storeCode",
        "orderType",
        "beType",
        "items"
      ],
      "type": "object"
    }
  },
  {
    "name": "cancel-order",
