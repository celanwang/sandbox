# Copy to .env and fill in the values for your machine.
# Existing shell environment variables take precedence.

# Used when starting Sandbox and Runner separately.
SANDBOX_ADMIN_TOKEN=
# Set these for a single manual run. Use a fresh pair for each episode.
# SANDBOX_EPISODE_ID=
# MCD_MCP_TOKEN=

# Used for Monitor shadow/active mode and model reclassification.
MONITOR_DASHSCOPE_API_KEY=
# MONITOR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Used by python -m runner.regression. The suite generates episode credentials.
IRIS_REGRESSION_REPO=../Iris
IRIS_REGRESSION_PG_PORT=54328
IRIS_REGRESSION_DB_NAME=iris_eval
IRIS_REGRESSION_DB_USER=postgres
IRIS_REGRESSION_DB_PASSWORD=
IRIS_REGRESSION_REDIS_PORT=59000
IRIS_REGRESSION_REDIS_DB=13
IRIS_REGRESSION_REDIS_PASSWORD=
